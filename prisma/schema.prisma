// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String   @id @default(cuid())
  tgId            String   @unique
  username        String?
  firstName       String?
  lastName        String?
  photoUrl        String?
  cards           Card[]
  transactions    Transaction[]

  recentSent      RecentRecipient[] @relation("RecentSenders")
  recentReceived  RecentRecipient[] @relation("RecentRecipients")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("users")
}

enum CardVariant {
  default
  dark
  primary
  savings
  business
  travel
}

model Card {
  id          String   @id @default(cuid())
  label       String
  balance     Int
  currency    String
  last4       String
  variant     CardVariant

  userId      String   
  user        User     @relation(fields: [userId], references: [tgId], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum TransactionStatus {
  completed
  pending
  failed
}

enum TransactionType {
  expense
  income
}


model Transaction {
id            String   @id @default(cuid())
transactionId String
userId        String   
amount        Int
category      String
logo          String
merchant      String
date          String

status        TransactionStatus
type          TransactionType
user          User     @relation(fields: [userId], references: [tgId], onDelete: Cascade)

notes         String?
cardLast4     String?
merchantInfo  String?

createdAt     DateTime @default(now())
updatedAt     DateTime @updatedAt
}

model RecentRecipient {
  id            String   @id @default(cuid())

  senderId      String
  recipientId   String
  sender        User @relation("RecentSenders", fields: [senderId], references: [tgId], onDelete: Cascade)
  recipient     User @relation("RecentRecipients", fields: [recipientId], references: [tgId], onDelete: Cascade)

  sendCount     Int      @default(1)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([senderId, recipientId])
}

enum Send {
  bot 
  user
}

model ChatMessage {
  id     String   @id @default(cuid())
  userId String
  sender Send
  text   String

  @@map("ChatMessages")
}